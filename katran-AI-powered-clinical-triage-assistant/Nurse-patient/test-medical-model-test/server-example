                    data.medications.forEach(med => {
                        medsHtml += `<div style="padding: 2px 0;">• ${med}</div>`;
                    });
                    document.getElementById('medicationsList').innerHTML = medsHtml;
                    
                    // Display allergies
                    let allergiesHtml = '';
                    data.allergies.forEach(allergy => {
                        allergiesHtml += `<div style="padding: 2px 0;">• ${allergy}</div>`;
                    });
                    document.getElementById('allergiesList').innerHTML = allergiesHtml;
                    
                } catch (error) {
                    console.error('Error loading database:', error);
                }
            }
            
            // Analyze conversation
            async function analyzeConversation() {
                const text = document.getElementById('conversationText').value;
                
                if (!text.trim()) {
                    alert('Please enter conversation text');
                    return;
                }
                
                try {
                    const response = await fetch('/analyze', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({text: text})
                    });
                    
                    if (!response.ok) {
                        throw new Error(`Server error: ${response.status}`);
                    }
                    
                    const data = await response.json();
                    
                    // Display questions
                    const questionsBox = document.getElementById('questionsBox');
                    const questions = data.check_result.questions;
                    
                    if (questions.length === 0) {
                        questionsBox.innerHTML = '<h4>✅ All Essential Information Collected!</h4><p>Good job! The conversation has covered all critical information.</p>';
                    } else {
                        let questionsHtml = '<h4>❓ Questions to Ask Next:</h4>';
                        questions.forEach(q => {
                            const criticalClass = q.priority === 'critical' ? 'critical' : '';
                            questionsHtml += `
                                <div class="question-item ${criticalClass}">
                                    <strong>${q.question}</strong>
                                    <div style="font-size: 12px; color: #666; margin-top: 3px;">${q.hint}</div>
                                </div>
                            `;
                        });
                        questionsBox.innerHTML = questionsHtml;
                    }
                    
                    // Display summary
                    const summaryBox = document.getElementById('summaryBox');
                    const summaryContent = document.getElementById('summaryContent');
                    
                    let summaryHtml = '<div style="margin-bottom: 10px;">';
                    
                    // Show extracted data
                    if (data.extracted.symptoms.length > 0) {
                        summaryHtml += '<div class="summary-item complete">✅ Symptoms: ' + 
                                      data.extracted.symptoms.map(s => s.item).join(', ') + '</div>';
                    }
                    
                    if (data.extracted.medications.length > 0) {
                        summaryHtml += '<div class="summary-item complete">✅ Medications: ' + 
                                      data.extracted.medications.join(', ') + '</div>';
                    }
                    
                    if (data.extracted.allergies.length > 0) {
                        summaryHtml += '<div class="summary-item complete">✅ Allergies: ' + 
                                      data.extracted.allergies.join(', ') + '</div>';
                    }
                    
                    if (data.extracted.time_info.duration || data.extracted.time_info.start_time) {
                        const time = data.extracted.time_info.duration || data.extracted.time_info.start_time;
                        summaryHtml += `<div class="summary-item complete">✅ Duration: ${time}</div>`;
                    }
                    
                    if (data.extracted.severity !== 'not mentioned') {
                        summaryHtml += `<div class="summary-item complete">✅ Severity: ${data.extracted.severity}</div>`;
                    }
                    
                    // Show missing items
                    data.check_result.missing_items.forEach(item => {
                        summaryHtml += `<div class="summary-item missing">❌ ${item.name} (${item.priority})</div>`;
                    });
                    
                    summaryHtml += '</div>';
                    summaryHtml += `<p><strong>Completion:</strong> ${data.check_result.summary.completion_rate}</p>`;
                    
                    summaryContent.innerHTML = summaryHtml;
                    summaryBox.style.display = 'block';
                    
                } catch (error) {
                    alert('Error analyzing conversation: ' + error.message);
                }
            }
            
            // Clear text
            function clearText() {
                document.getElementById('conversationText').value = '';
                document.getElementById('questionsBox').innerHTML = '<h4>Questions to Ask Next:</h4><p>Click "Analyze" to see questions...</p>';
                document.getElementById('summaryBox').style.display = 'none';
            }
            
            // Initialize
            document.addEventListener('DOMContentLoaded', function() {
                // Initial load of database if on that tab
                if (document.getElementById('database').classList.contains('active')) {
                    loadDatabaseContent();
                }
            });
        </script>
    </body>
    </html>
    """

@app.post("/analyze")
async def analyze_conversation(data: dict):
    """Analyze conversation text and return results"""
    if "text" not in data:
        raise HTTPException(status_code=400, detail="No text provided")
    
    text = data["text"]
    
    # Step 1: Extract medical information
    extracted_data = extractor.extract(text)
    
    # Step 2: Check for missing information
    check_result = checker.check(extracted_data)
    
    return {
        "status": "success",
        "extracted": extracted_data,
        "check_result": check_result
    }

@app.get("/database")
async def get_database():
    """Return the current medical database"""
    try:
        with open("medical_db.json", "r", encoding="utf-8") as f:
            db = json.load(f)
        return db
    except FileNotFoundError:
        raise HTTPException(status_code=404, detail="Database file not found")

