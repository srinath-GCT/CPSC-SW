"""
AI Nursing Assistant - Main Server
Simple 2-tab interface for demonstration
"""
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from fastapi.middleware.cors import CORSMiddleware
import uvicorn
import json

from medical_extractor import MedicalExtractor
from missing_checker import MissingChecker

# Initialize components
app = FastAPI(title="AI Nursing Assistant Demo", version="1.0")

# Allow CORS for development
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Initialize our modules
extractor = MedicalExtractor("medical_db.json")
checker = MissingChecker()

